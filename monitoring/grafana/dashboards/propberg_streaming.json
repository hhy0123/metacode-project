  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Kafka topic 인입 rate (1분 평균, msg/s)",
      "description": "토픽별 새 메시지 인입 속도. 0이면 producer가 멈춤 또는 dedupe로 새 row가 없는 상태.",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset{topic!~\"__.*\"}[1m]))",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        }
      },
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Consumer group lag (records)",
      "description": "Spark Streaming consumer가 따라잡지 못한 메시지 수. 지속 증가 = backpressure 위험.",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{topic!~\"__.*\"})",
          "legendFormat": "{{consumergroup}} / {{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 1000},
              {"color": "red", "value": 10000}
            ]
          }
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "토픽별 누적 메시지 수 (current offset)",
      "description": "Kafka 토픽이 시작부터 받은 총 메시지 수. 우상향 증가 = streaming 살아있음.",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (topic) (kafka_topic_partition_current_offset{topic!~\"__.*\"})",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "토픽 partition 수",
      "description": "토픽별 partition 개수 — 100x 스케일 시 증설 필요 여부 확인.",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "kafka_topic_partitions{topic!~\"__.*\"}",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "type": "stat",
      "title": "Service health (Prometheus targets up)",
      "description": "scrape target의 UP/DOWN. 0이면 해당 컴포넌트와 Prometheus 사이 연결 끊김.",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": 0},
              {"color": "green", "value": 1}
            ]
          },
          "mappings": [
            {"options": {"0": {"text": "DOWN", "color": "red"}}, "type": "value"},
            {"options": {"1": {"text": "UP",   "color": "green"}}, "type": "value"}
          ]
        }
      },
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 16}
    }
  ],
