# 국토부 실거래가 API
MOLIT_API_KEY=your_molit_key_here

# 한국부동산원 R-ONE API
RONE_API_KEY=your_rone_key_here

# 통계청 KOSIS API
KOSIS_API_KEY=your_kosis_key_here

# AWS
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=your_secret_here
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
S3_BUCKET=propberg-lakehouse-hhy

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Glue
GLUE_DATABASE_BRONZE=propberg_bronze
GLUE_DATABASE_SILVER=propberg_silver
GLUE_DATABASE_GOLD=propberg_gold
GLUE_ROLE=GluePropbergRole

# Streaming
STREAMING_TRIGGER_INTERVAL=60 seconds
MOLIT_POLL_INTERVAL=300
RONE_POLL_INTERVAL=3600
KOSIS_POLL_INTERVAL=21600
